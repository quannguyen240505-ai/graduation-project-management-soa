            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {\r\n    const data = pm.response.json();\r\n\r\n    pm.environment.set(\"lecturerToken\", data.accessToken);\r\n    pm.environment.set(\"lecturerId\", data.userId);\r\n}"
                ]
