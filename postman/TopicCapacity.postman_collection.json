{
  "info": {
    "name": "Graduation SOA Capacity Test",
    "description": "Bo sung test current_students. Chay Folder 01 - Auth cua collection nhom truoc, chon Environment Graduation SOA Local voi baseUrl=http://localhost:8080. Chay 01-20 theo thu tu. Tao topic moi rieng, khong ghi de topicId/registrationId cua bo test nhom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "06 - Topic Capacity",
      "item": [
        {
          "name": "01 - Create capacity topic (max = 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lecturerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/topics",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topicCode\": \"{{capacityTopicCode}}\",\n  \"topicName\": \"Demo dong bo so sinh vien\",\n  \"description\": \"Topic dung rieng cho bo test capacity\",\n  \"lecturerId\": {{lecturerId}},\n  \"maxStudents\": 1,\n  \"field\": \"Cong nghe thong tin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"capacityTopicCode\", \"CAP_\" + Date.now());",
                  "pm.environment.unset(\"capacityTopicId\");",
                  "pm.environment.unset(\"capacityRegistrationId\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set(\"capacityTopicId\", pm.response.json().id);",
                  "  pm.test(\"New topic has zero students\", () => pm.expect(pm.response.json().currentStudents).to.eql(0));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Student creates PENDING registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
