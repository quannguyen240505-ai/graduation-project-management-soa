            "url": "{{baseUrl}}/api/registrations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{studentId}},\n  \"topicId\": {{capacityTopicId}},\n  \"note\": \"Test so cho theo APPROVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set(\"capacityRegistrationId\", pm.response.json().id);",
                  "  pm.test(\"PENDING\", () => pm.expect(pm.response.json().status).to.eql(\"PENDING\"));",
                  "}"
                ]
              }
            }
          ]
        },
