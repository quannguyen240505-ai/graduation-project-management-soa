                  "pm.test('Đúng instance', () => pm.expect(pm.response.headers.get('X-Topic-Instance')).to.eql('topic-service:8085'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Gateway GET 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayURL}}/api/topics"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('seenInstances','[]');",
                  "pm.collectionVariables.unset('topicSnapshot');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function canonical(v) {",
                  "  if (Array.isArray(v)) return v.map(canonical).sort((a,b) => JSON.stringify(a).localeCompare(JSON.stringify(b)));",
                  "  if (v && typeof v === 'object') return Object.fromEntries(Object.keys(v).sort().map(k => [k,canonical(v[k])]));",
                  "  return v;",
                  "}",
                  "pm.test('HTTP 200 và header đúng', () => {",
                  " pm.response.to.have.status(200);",
                  " const id = pm.response.headers.get('X-Topic-Instance');",
                  " pm.expect(['topic-service:8082','topic-service:8085']).to.include(id);",
                  " const seen = JSON.parse(pm.collectionVariables.get('seenInstances') || '[]');",
                  " if (!seen.includes(id)) seen.push(id);",
                  " pm.collectionVariables.set('seenInstances',JSON.stringify(seen));",
                  "});",
                  "pm.test('Dữ liệu không đổi qua các instance', () => {",
                  " const body = pm.response.json(); pm.expect(body).to.be.an('array');",
                  " const snapshot = JSON.stringify(canonical(body));",
                  " const before = pm.collectionVariables.get('topicSnapshot');",
                  " if (!before) pm.collectionVariables.set('topicSnapshot',snapshot);",
                  " else pm.expect(snapshot).to.eql(before);",
                  "});"
                ]
              }
            }
          ]
        },
